{
  "version": 1,
  "main": "main",
  "kinds": {
    "task": {
      "file": "docs/issues.json",
      "list": "issues",
      "id": "id",
      "says": "note",
      "done": { "field": "status", "values": ["fixed", "answered", "confirmed"] },
      "links": { "use-case": "useCase", "feature": "feature" },
      "bands": {
        "now": [{ "field": "next" }, { "field": "pitch" }],
        "later": [{ "field": "status", "values": ["blocked"] }, { "field": "blockedBy" }]
      }
    },
    "use-case": {
      "file": "docs/use-cases.json",
      "list": "useCases",
      "id": "id",
      "says": "goal",
      "reader": { "field": "actor", "values": ["hafiz"] },
      "links": { "feature": "feature" }
    },
    "feature": { "file": "docs/map.json", "list": "features", "id": "id", "files": { "field": "entry", "key": "file" } },
    "plan": { "glob": ".claude/plans/*.md" }
  }
}
