{
  "name": "@hifth/etl",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Hifth ETL — extract assets, build anchors/adjacency/roots/skins, validate (Node, offline)",
  "type": "module",
  "scripts": {
    "extract:pages": "node scripts/extract-pages.mjs",
    "vendor:pages": "node scripts/vendor-pages.mjs",
    "build:adjacency": "node scripts/build-adjacency.mjs",
    "build:roots": "node scripts/build-roots.mjs",
    "build:tajweed": "node scripts/build-tajweed.mjs",
    "audit:corpus": "node scripts/audit-corpus.mjs",
    "etl": "node scripts/etl.mjs",
    "etl:list": "node scripts/etl.mjs --list",
    "etl:hold": "node scripts/etl.mjs held-copy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "svgo": "4.0.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@hifth/core": "workspace:*"
  }
}
