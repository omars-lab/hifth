node_modules/
dist/
.turbo/
*.tsbuildinfo
apps/web/dev-dist/
apps/web/playwright-report/
apps/web/test-results/
# Lighthouse CI run artifacts (the gate's thresholds live in .lighthouserc.json,
# which IS committed; the reports it produces are per-run noise).
.lighthouseci/
.DS_Store

# The quran-svg fetch cache: 348 MB of upstream page SVG + per-page metadata,
# pinned by SHA-256 in packages/etl/data/pages/quran-svg.pin.json. The pin is
# committed; the corpus it points at is not (see vendor-pages.mjs).
packages/etl/data/pages/.cache/

# Maintainer reports built out of that cache — probe-encodings.mjs writes a
# self-contained HTML file here, and it is full of Arabic derived from the print.
# There is no Quran text in this repo and there will not be; a committed report
# would vendor the mus'haf through the back door, so the output directory is
# ignored wholesale rather than per-file.
packages/etl/out/

# The publishable copy of a decision's options page. `--artifact` re-renders the
# committed page with every asset inlined, because the host it is published to
# blocks external requests — so it is the same page at roughly twice the bytes,
# and committing both would put two copies of one picture under version control.
# The committed one is what docs/decisions.json points at; this is a build step
# on the way out the door.
docs/design/*.artifact.html

# Parallel-agent worktrees: checkouts of *other* branches living inside this one.
# Committing them would put another branch's tree into this branch's history, and
# linting them makes this branch fail on code it does not contain (see
# eslint.config.js `ignores`).
.claude/worktrees/

# Secrets — never commit. Enforced by gitleaks (see .gitleaks.toml + CI).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
**/credentials.json

# The QUL mutashabihat ruler: a login-gated phrase-recurrence catalogue read ONCE
# into this cache as a build-time measuring stick for the hop's recall
# (what-we-depend-on ⑪ / probe-hop-recall.mjs). Zero bytes of it ship — the
# committed finding is docs/design/hop-recall.data.json, numbers and verse keys only.
packages/etl/data/mutashabihat/.cache/

# MASAQ (Mendeley 9yvrzxktmr, CC BY): a third, independent grammatical analysis of
# the whole Qur'an, read ONCE into this cache as a build-time witness for the
# segmentation split (what-we-depend-on ⑩ / probe-segmentation-witness.mjs). Zero
# bytes of it ship — the committed finding is docs/design/segmentation-witness.data.json,
# counts and verse keys only.
packages/etl/data/segmentation/.cache/

# The MushafDatabase ligature SVG fetch cache: per-ligature outlines with
# Arabic data-text, read at build time to derive letter/mark outlines (numbers
# and shapes only ship). The corpus it points at is not committed.
packages/etl/data/ligature/.cache/

# Font shaping for the harakah picker: cached font + verse text (build-time inputs, never shipped)
packages/etl/data/shaped/.cache/
