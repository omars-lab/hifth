node_modules/
dist/
.turbo/
*.tsbuildinfo
apps/web/dev-dist/
apps/web/playwright-report/
apps/web/test-results/
# Lighthouse CI run artifacts (the gate's thresholds live in .lighthouserc.json,
# which IS committed; the reports it produces are per-run noise).
.lighthouseci/
.DS_Store

# Parallel-agent worktrees: checkouts of *other* branches living inside this one.
# Committing them would put another branch's tree into this branch's history, and
# linting them makes this branch fail on code it does not contain (see
# eslint.config.js `ignores`).
.claude/worktrees/

# Secrets — never commit. Enforced by gitleaks (see .gitleaks.toml + CI).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
**/credentials.json
