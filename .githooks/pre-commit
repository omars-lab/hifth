#!/usr/bin/env sh
# Pre-commit secret scan. Blocks a commit if gitleaks finds a secret in the
# staged changes. Config + allowlist: .gitleaks.toml.
#
# Installed by `pnpm install` (the root "prepare" script points core.hooksPath
# at .githooks/). To skip in an emergency: `git commit --no-verify` (CI still
# runs a full-history scan, so a skipped secret is caught before it merges).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — skipping secret scan."
  echo "  install it:  brew install gitleaks   (or see github.com/gitleaks/gitleaks)"
  echo "  the CI secrets-scan job still gates every push."
  exit 0
fi

# `git --staged` scans only what is about to be committed (gitleaks 8.19+ —
# the old `protect` subcommand was removed). --redact keeps any match out of
# the terminal output. Exit 1 = leak found, 0 = clean.
gitleaks git --staged --redact --config .gitleaks.toml
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "pre-commit: gitleaks found a potential secret in your staged changes (above)."
  echo "  remove it, or if it is a false positive add an allowlist entry to .gitleaks.toml."
  echo "  to bypass this one commit:  git commit --no-verify"
  exit 1
fi

# The code map (docs/map.json) points a newcomer at the entrypoint of every
# feature, and a map is worth reading only while it is true. This is the moment
# to check it: you are renaming the thing right now, so you know where it went.
# Ten minutes from now nobody does, and a year from now the map is fiction that
# still reads like fact.
#
# Scoped to the staged files, so it costs nothing on a commit that touches
# nothing mapped, and it stays silent in that case rather than printing an OK
# nobody asked for. CI runs the whole map on every push regardless.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ] && command -v node >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  if ! node scripts/gate-map.mjs --files $staged; then
    echo ""
    echo "pre-commit: docs/map.json points somewhere that no longer exists (above)."
    echo "  fix the entry — 'make map FEATURE=<id>' shows what it currently claims."
    echo "  to bypass this one commit:  git commit --no-verify"
    exit 1
  fi
fi

exit 0
