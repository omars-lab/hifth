# ---------------------------------------------------------------------------
# The Mac / iPad shell (native/). Included by the root Makefile; every target
# here starts with `app-` and is documented with `##` so `make help` lists it.
#
#   make app-web            copy the PRIVATE pitch web build into the app
#   make app-web FLAVOUR=public   copy the public build (refuses held data)
#   make app-run-mac        build and open the Mac app
#   make app-run-ipad       build, install and launch on the iPad simulator
#   make app-shot ROUTE=/hafs-kfqc/p45 TARGET=ipad|mac [APPEARANCE=dark]
#   make app-open ROUTE=/hafs-kfqc/2:255   turn the running app to a route
#   make app-callback-check an x-callback request through macOS, answer received by a second process
#   make app-test           route/bundle unit tests + the XCUITest smoke
#   make app-walk ROUTES='/hafs-kfqc/2:255?open=commentary …' [SIDEWAYS=1]   a picture per route, to look at
#   make app-golden         the real app's screenshots against native/shots/baseline/
#   make app-device-install build for a plugged-in iPad, install and launch (DEVICE=…)
# ---------------------------------------------------------------------------

# A stale CPATH from Homebrew breaks Xcode's clang module search.
unexport CPATH

NATIVE       := native
XCPROJ       := $(NATIVE)/Hifth.xcodeproj
DERIVED      := $(NATIVE)/build
WEB_BUNDLE   := $(NATIVE)/WebBundle
SHOTS        := $(NATIVE)/shots
BUNDLE_ID    := com.bytesofpurpose.hifth
XCB          := xcodebuild -project $(XCPROJ) -derivedDataPath $(DERIVED)
XCPRETTY     := $(shell command -v xcbeautify >/dev/null 2>&1 && echo "xcbeautify" || echo "cat")
MAC_APP      := $(DERIVED)/Build/Products/Debug/Hifth.app
IPAD_APP     := $(DERIVED)/Build/Products/Debug-iphonesimulator/Hifth.app
# The Mac app is started through macOS's launcher, never by running the binary
# inside it: started that way it runs with no window at all, so the page is
# 0×0 and hidden and its picture comes out empty (native-shell.md ⑪). A new
# copy (-n), in the background so it does not take the keyboard from whatever
# you are in (-g), with no windows restored from last time (-F), waiting until
# it quits (-W); what it prints lands in MAC_LOG. Add `--env NAME=value`.
MAC_LOG      := $(DERIVED)/mac-stdout.log
MAC_OPEN     := open -n -g -F -W --stdout $(abspath $(MAC_LOG)) --stderr $(abspath $(MAC_LOG))
# Which web build goes in: `pitch` (private, with the held commentary) or
# `public` (what the site ships).
FLAVOUR      ?= pitch
# The simulator the iPad targets use. Any name from `xcrun simctl list devices`.
IPAD         ?= iPad Pro 13-inch (M5)
IPAD_UDID     = $(shell $(NATIVE)/scripts/simulator-udid.sh "$(IPAD)")
ROUTE        ?= /hafs-kfqc/2:255
TARGET       ?= ipad
# app-probe: one more JavaScript question for the page, asked DELAY_MS after it
# says it is ready (double quotes inside it; the Makefile wraps it in single).
EVAL         ?=
# app-test: some XCUITests instead of the whole run, space-separated, e.g. ONLY=SmokeTests/testOpensAtAVerse
ONLY         ?=
# app-walk: the routes to open, space-separated, and whether to hold it sideways.
ROUTES       ?= $(ROUTE)
SIDEWAYS     ?=
# Upright and sideways pictures in their own folders, so one run never
# deletes the other's before anyone has looked at them.
WALK_OUT     ?= $(SHOTS)/walk/$(if $(SIDEWAYS),side,upright)
DELAY_MS     ?= 2000
APPEARANCE   ?= light
# `/hafs-kfqc/p45?field=dark` → `ipad-hafs-kfqc_p45_field-dark.png`
# Where `app-shot` writes; `app-golden` points it at native/shots/current/.
SHOT_OUT     ?= $(SHOTS)/$(SHOT_NAME)
# The routes the shell goldens cover: a verse, a page, and the dark desk.
GOLDEN_ROUTES ?= /hafs-kfqc/2:255 /hafs-kfqc/p45 /hafs-kfqc/p45?field=dark
# The same app on a phone, one route: the shell was first looked at there on
# 2026-09-29 (native-shell.md ③) and this row is what notices if it changes.
IPHONE        ?= iPhone 17
GOLDEN_IPHONE_ROUTES ?= /hafs-kfqc/2:255
# The Apple Development team, read from the signing identity in the keychain.
# Only device builds and archives need it; simulator and Mac builds do not.
TEAM         ?= $(shell security find-identity -v -p codesigning 2>/dev/null | sed -n 's/.*Apple Development: .*(\([A-Z0-9]\{10\}\)).*/\1/p' | head -1)
# The plugged-in iPad, by the name `xcrun devicectl list devices` prints.
DEVICE       ?=
SHOT_NAME     = $(TARGET)-$(subst /,_,$(subst ?,_,$(subst =,-,$(subst :,-,$(patsubst /%,%,$(ROUTE))))))$(if $(filter-out light,$(APPEARANCE)),-$(APPEARANCE),).png

.PHONY: app-icon app-generate app-web app-build-mac app-build-ipad app-run-mac app-run-mac-stdout app-callback-check \
        app-run-ipad app-shot app-probe app-open app-test app-walk app-test-mac-ui app-unit-test app-logs app-clean \
        app-golden app-golden-update app-device-install app-archive app-testflight

app-icon: ## Cut every Mac and iPad icon size from the web app's own icon (apps/web/public/icons)
	python3 $(NATIVE)/scripts/make-appicon.py

app-generate: ## Regenerate native/Hifth.xcodeproj from native/project.yml
	@mkdir -p $(WEB_BUNDLE)
	cd $(NATIVE) && xcodegen generate --quiet

app-web: core ## Build the web app and copy it into the shell (FLAVOUR=pitch|public, pitch by default)
	@# The pitch build keeps assets/private (the held commentary); the public
	@# build is copied without it and then checked, so a public shell can never
	@# carry held copy even on a laptop that has it.
ifeq ($(FLAVOUR),pitch)
	@test -e apps/web/public/assets/private/study-quran/1.json || { \
	  echo ""; echo "  No private pitch data at apps/web/public/assets/private/study-quran/"; \
	  echo "  Build it first (node packages/etl/tools/pitch/extract.mjs) or use FLAVOUR=public"; echo ""; exit 1; }
	VITE_PITCH=1 $(WEB) exec vite build --outDir dist-native --emptyOutDir
else
	$(WEB) exec vite build --outDir dist-native --emptyOutDir
endif
	@$(MAKE) --no-print-directory app-web-copy FLAVOUR=$(FLAVOUR)

.PHONY: app-web-copy
# The copy alone, so a test can drive it without a web build. A folder the copy
# skips is also one it never deletes, so the public copy deletes skipped
# folders too: switching from the pitch build must not keep its private folder.
DIST ?= apps/web/dist-native
app-web-copy:
	@mkdir -p $(WEB_BUNDLE)
ifeq ($(FLAVOUR),pitch)
	rsync -a --delete $(DIST)/ $(WEB_BUNDLE)/
else
	rsync -a --delete --delete-excluded --exclude 'assets/private' $(DIST)/ $(WEB_BUNDLE)/
	@test ! -e $(WEB_BUNDLE)/assets/private || { echo "held data reached the public shell bundle"; exit 1; }
endif
	@echo "$(FLAVOUR)" > $(WEB_BUNDLE)/.hifth-web-flavour
	@echo "  ✓ $(FLAVOUR) web build in $(WEB_BUNDLE) ($$(find $(WEB_BUNDLE) -type f | wc -l | tr -d ' ') files)"

app-build-mac: app-generate ## Build the Mac app (Debug, ad-hoc signed)
	set -o pipefail; $(XCB) -scheme Hifth-macOS -configuration Debug -destination 'platform=macOS' build | $(XCPRETTY)

app-build-ipad: app-generate ## Build the iPad app for the simulator
	set -o pipefail; $(XCB) -scheme Hifth-iOS -configuration Debug -sdk iphonesimulator \
	  -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' CODE_SIGNING_ALLOWED=NO build | $(XCPRETTY)

app-run-mac: app-build-mac ## Build and open the Mac app (ROUTE=… to open at a route)
	@# Registering the build with Launch Services makes `open hifth://…` land
	@# on this copy and not on an older one lying in DerivedData.
	/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f $(MAC_APP)
	HIFTH_ROUTE=$(ROUTE) open -a $(MAC_APP)

app-callback-check: app-build-mac ## Send one x-callback-url request through macOS to the app and check a second process gets the answer (opens one browser tab)
	$(NATIVE)/scripts/callback-check.sh $(MAC_APP) $(BUNDLE_ID)

app-run-mac-stdout: app-build-mac ## Run the Mac app until you quit it, then print its console output here (live: make app-logs)
	@: > $(MAC_LOG)
	$(MAC_OPEN) --env HIFTH_ROUTE=$(ROUTE) --env HIFTH_APPEARANCE=$(APPEARANCE) $(MAC_APP)
	@cat $(MAC_LOG)

app-run-ipad: app-build-ipad ## Boot the simulator, install and launch at ROUTE
	@test -n "$(IPAD_UDID)" || { echo "no simulator named '$(IPAD)'; see xcrun simctl list devices"; exit 1; }
	xcrun simctl bootstatus $(IPAD_UDID) -b
	open -a Simulator
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	SIMCTL_CHILD_HIFTH_ROUTE=$(ROUTE) SIMCTL_CHILD_HIFTH_APPEARANCE=$(APPEARANCE) xcrun simctl launch $(IPAD_UDID) $(BUNDLE_ID)

app-shot: ## Screenshot the app at ROUTE on TARGET=ipad|mac (APPEARANCE=light|dark) into native/shots/
	@mkdir -p $(SHOTS)
ifeq ($(TARGET),mac)
	$(MAKE) app-build-mac
	@rm -f $(SHOT_OUT); : > $(MAC_LOG)
	$(MAC_OPEN) --env HIFTH_ROUTE=$(ROUTE) --env HIFTH_APPEARANCE=$(APPEARANCE) \
	  --env HIFTH_SNAPSHOT_PATH=$(abspath $(SHOT_OUT)) $(MAC_APP)
	@cat $(MAC_LOG)
else
	$(MAKE) app-build-ipad
	xcrun simctl bootstatus $(IPAD_UDID) -b
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	@rm -f $(SHOT_OUT)
	SIMCTL_CHILD_HIFTH_ROUTE=$(ROUTE) SIMCTL_CHILD_HIFTH_APPEARANCE=$(APPEARANCE) \
	  SIMCTL_CHILD_HIFTH_SNAPSHOT_PATH=$(abspath $(SHOT_OUT)) \
	  xcrun simctl launch $(IPAD_UDID) $(BUNDLE_ID)
	@for i in $$(seq 1 60); do test -s $(SHOT_OUT) && break; sleep 0.5; done
	@test -s $(SHOT_OUT) || { echo "no screenshot after 30 s"; exit 1; }
endif
	@# An empty file, or a picture with no pixels, is a failure, not a shot:
	@# the Mac app once wrote 0 bytes here for weeks and this line said ✓.
	@test -s $(SHOT_OUT) || { echo "  ✗ $(SHOT_OUT) is empty"; exit 1; }
	@sips -g pixelWidth $(SHOT_OUT) | awk '/pixelWidth/ { exit !($$2 > 0) }' || { echo "  ✗ $(SHOT_OUT) has no pixels"; exit 1; }
	@echo "  ✓ $(SHOT_OUT)"

app-probe: ## Print what the page sees inside the shell, TARGET=mac|ipad [EVAL='js expression'] [DELAY_MS=…]
ifeq ($(TARGET),ipad)
	$(MAKE) app-build-ipad
	xcrun simctl bootstatus $(IPAD_UDID) -b
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	SIMCTL_CHILD_HIFTH_PROBE=1 SIMCTL_CHILD_HIFTH_ROUTE='$(ROUTE)' SIMCTL_CHILD_HIFTH_PROBE_EVAL='$(EVAL)' \
	  SIMCTL_CHILD_HIFTH_PROBE_DELAY_MS=$(DELAY_MS) \
	  xcrun simctl launch --console-pty --terminate-running-process $(IPAD_UDID) $(BUNDLE_ID) \
	  | grep '^probe' | sed 's/^probe //' | python3 -m json.tool
else
	$(MAKE) app-build-mac
	@: > $(MAC_LOG)
	$(MAC_OPEN) --env HIFTH_PROBE=1 --env HIFTH_ROUTE='$(ROUTE)' --env HIFTH_PROBE_EVAL='$(EVAL)' \
	  --env HIFTH_PROBE_DELAY_MS=$(DELAY_MS) $(MAC_APP)
	@grep '^probe' $(MAC_LOG) | sed 's/^probe //' | python3 -m json.tool
endif

app-open: ## Turn the running app to ROUTE (TARGET=ipad|mac)
ifeq ($(TARGET),mac)
	open "hifth://$(ROUTE)"
else
	xcrun simctl openurl $(IPAD_UDID) "hifth://$(ROUTE)"
endif

app-unit-test: app-generate ## Route, bundle-path and bridge unit tests (Mac, seconds)
	set -o pipefail; $(XCB) -scheme Hifth-macOS -destination 'platform=macOS' -only-testing:HifthTests test | $(XCPRETTY)

app-test: $(if $(ONLY),app-generate,app-unit-test) ## Unit tests plus the XCUITest smoke on the iPad simulator [ONLY=SmokeTests/testName]
	@rm -rf $(SHOTS)/ipad-smoke.xcresult
	set -o pipefail; $(XCB) -scheme Hifth-iOS -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' \
	  CODE_SIGNING_ALLOWED=NO -resultBundlePath $(SHOTS)/ipad-smoke.xcresult \
	  $(foreach t,$(ONLY),-only-testing:HifthUITests-iOS/$(t)) test | $(XCPRETTY)

app-walk: app-generate ## Open each of ROUTES in the iPad app (SIDEWAYS=1 to turn it) and save a picture of each to native/shots/walk/upright or side/
	@rm -rf $(SHOTS)/ipad-walk.xcresult $(WALK_OUT)
	set -o pipefail; TEST_RUNNER_WALK_ROUTES='$(ROUTES)' TEST_RUNNER_WALK_SIDEWAYS='$(SIDEWAYS)' \
	  $(XCB) -scheme Hifth-iOS -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' \
	  CODE_SIGNING_ALLOWED=NO -resultBundlePath $(SHOTS)/ipad-walk.xcresult \
	  -only-testing:HifthUITests-iOS/WalkTests test | $(XCPRETTY)
	xcrun xcresulttool export attachments --path $(SHOTS)/ipad-walk.xcresult --output-path $(WALK_OUT) > /dev/null
	@node $(NATIVE)/scripts/name-attachments.mjs $(WALK_OUT)

app-test-mac-ui: app-generate ## The XCUITest smoke on the Mac (needs Accessibility permission for your terminal — see docs/design/native-shell.md)
	@rm -rf $(SHOTS)/mac-smoke.xcresult
	set -o pipefail; $(XCB) -scheme Hifth-macOS -destination 'platform=macOS' -only-testing:HifthUITests-macOS \
	  -resultBundlePath $(SHOTS)/mac-smoke.xcresult test | $(XCPRETTY)

# ---- the real app's look: one screenshot per route, against a committed baseline
# Same recipe as the web goldens: `app-golden` fails on a change, you LOOK at
# native/shots/diff/, and only then `app-golden-update` accepts the new look.
app-golden: app-golden-shots ## Screenshot GOLDEN_ROUTES on the iPad (and GOLDEN_IPHONE_ROUTES on the iPhone) simulator and diff against native/shots/baseline/
	$(NATIVE)/scripts/golden-diff.sh $(SHOTS)/current $(SHOTS)/baseline $(SHOTS)/diff

app-golden-update: app-golden-shots ## Accept the current shell screenshots as the new baseline — look at the diff first
	@mkdir -p $(SHOTS)/baseline
	cp $(SHOTS)/current/*.png $(SHOTS)/baseline/
	@echo "  baseline updated: $$(ls $(SHOTS)/baseline | wc -l | tr -d ' ') screenshots"

.PHONY: app-golden-public app-golden-shots
# The baseline is committed to a public repository, so it is taken of the public
# build: a pitch picture of a verse with its note open carries The Study Quran's
# words in its pixels, where no text check can see them (native-shell.md ⑲).
app-golden-public:
	@test "$$(cat $(WEB_BUNDLE)/.hifth-web-flavour 2>/dev/null)" = public || { \
	  echo ""; echo "  The app's comparison pictures are committed to a public repository, so they"; \
	  echo "  are taken of the public build, never the pitch. Run: make app-web FLAVOUR=public"; echo ""; exit 1; }

# Shots are halved (the simulator draws at 2x) so a baseline is a few hundred KB, not 2 MB.
app-golden-shots: app-golden-public
	@rm -rf $(SHOTS)/current && mkdir -p $(SHOTS)/current
	@for r in $(GOLDEN_ROUTES); do \
	  name=$$(printf '%s' "$$r" | sed 's#^/##; s#[/:?=]#_#g'); \
	  $(MAKE) --no-print-directory app-shot TARGET=ipad ROUTE="$$r" SHOT_OUT=$(SHOTS)/current/ipad-$$name.png || exit 1; \
	  magick mogrify -resize 50% $(SHOTS)/current/ipad-$$name.png; \
	done
	@for r in $(GOLDEN_IPHONE_ROUTES); do \
	  name=$$(printf '%s' "$$r" | sed 's#^/##; s#[/:?=]#_#g'); \
	  $(MAKE) --no-print-directory app-shot TARGET=ipad IPAD="$(IPHONE)" ROUTE="$$r" SHOT_OUT=$(SHOTS)/current/iphone-$$name.png || exit 1; \
	  magick mogrify -resize 50% $(SHOTS)/current/iphone-$$name.png; \
	done

# ---- a real iPad over USB
app-device-install: app-generate ## Build for a plugged-in iPad, install and launch at ROUTE (DEVICE=<name from `xcrun devicectl list devices`>)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	@test -n "$(TEAM)" || { echo "  no Apple Development identity in the keychain (TEAM= to override)"; exit 1; }
	set -o pipefail; $(XCB) -scheme Hifth-iOS -destination 'generic/platform=iOS' -allowProvisioningUpdates \
	  DEVELOPMENT_TEAM=$(TEAM) build | $(XCPRETTY)
	xcrun devicectl device install app --device "$(DEVICE)" $(DERIVED)/Build/Products/Debug-iphoneos/Hifth.app
	DEVICECTL_CHILD_HIFTH_ROUTE=$(ROUTE) xcrun devicectl device process launch --device "$(DEVICE)" $(BUNDLE_ID)

# ---- TestFlight: gated on the licence decision, not on the build
# Both refuse while docs/decisions.json still holds `native-testflight-licence`
# open. The record says why in plain words; settle it there first.
TESTFLIGHT_SETTLED = $(shell python3 -c "import json; r=[d for d in json.load(open('docs/decisions.json'))['decisions'] if d['id']=='native-testflight-licence']; print('yes' if r and r[0]['status']!='open' else 'no')" 2>/dev/null)
define TESTFLIGHT_GATE
	@test "$(TESTFLIGHT_SETTLED)" = yes || { echo ""; \
	  echo "  Not yet. Whether a build with the held commentary may go to outside testers is"; \
	  echo "  still open: docs/decisions/native-testflight-licence.md. Settle it there first."; echo ""; exit 1; }
endef

app-archive: app-generate ## Archive the iPad app for upload (refuses until the TestFlight decision is settled)
	$(TESTFLIGHT_GATE)
	@echo "  archive: not built yet — the export options, privacy manifest and signing come with the decision (docs/backlog.md)"; exit 1

app-testflight: app-archive ## Upload the archive to TestFlight with an App Store Connect API key from the environment
	@echo "  upload: not built yet"; exit 1

app-logs: ## Stream the app's console output (Mac or simulator)
	log stream --predicate 'process == "Hifth"' --level debug

app-clean: ## Remove the shell's build output and generated project
	rm -rf $(DERIVED) $(XCPROJ)
