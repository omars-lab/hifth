# ---------------------------------------------------------------------------
# The Mac / iPad shell (native/). Included by the root Makefile; every target
# here starts with `app-` and is documented with `##` so `make help` lists it.
#
#   make app-web            copy the PRIVATE pitch web build into the app
#   make app-web FLAVOUR=public   copy the public build (refuses held data)
#   make app-run-mac        build and open the Mac app
#   make app-run-ipad       build, install and launch on the iPad simulator
#   make app-shot ROUTE=/hafs-kfqc/p45 TARGET=ipad|mac [APPEARANCE=dark] [LOCALE=ar|en] [WINDOW=1280x800, Mac]
#   make app-store-shots    the store's screenshots of the public build, at Apple's sizes, both languages
#   make app-open ROUTE=/hafs-kfqc/2:255   turn the running app to a route
#   make app-callback-check an x-callback request through macOS, answer received by a second process
#   make app-test           route/bundle unit tests + the XCUITest smoke
#   make app-walk ROUTES='/hafs-kfqc/2:255?open=commentary …' [SIDEWAYS=1] [LOCALE=ar|en]   a picture per route, to look at
#   make app-golden         the real app's screenshots against native/shots/baseline/
#   make app-device-install build for a plugged-in iPad, install and launch (DEVICE=…)
#   make app-release-ipad DEVICE=…   the iPad checks, install, open it watched; fails on a new crash report
#   make app-crash-logs DEVICE=… [SINCE=<ISO time>]   copy the app's crash reports off the iPad, one line each
#   make walk-pull DEVICE=… [CLEAR=1]   copy the screenshots kept on a walk off the iPad, and draw them as one page
#   make walk-gallery · make walk-list [JSON=1]   redraw that page · list the captures, oldest first
#   make app-release-check   fail if the release iPad build carries any of the walk capture
#                            (TARGET=mac: the Mac builds, and the sandboxed one's permissions)
#   make app-store-flavour   fail unless the web build in the app is the public one (an archive needs it)
#   make app-archive-mac · make app-export-mac   the Mac App Store archive, then its installer package,
#                            each checked; nothing leaves the laptop (app-store-check-mac sends it to Apple's check)
#   make app-devices [CSV=1]   the registered devices, and the slots of each kind left this year
#   make app-device-register DEVICE=…   register a new device with Apple (uses a slot), then install
# ---------------------------------------------------------------------------

# A stale CPATH from Homebrew breaks Xcode's clang module search.
unexport CPATH

NATIVE       := native
XCPROJ       := $(NATIVE)/Hifth.xcodeproj
DERIVED      := $(NATIVE)/build
WEB_BUNDLE   := $(NATIVE)/WebBundle
SHOTS        := $(NATIVE)/shots
BUNDLE_ID    := com.bytesofpurpose.hifth
XCB          := xcodebuild -project $(XCPROJ) -derivedDataPath $(DERIVED)
XCPRETTY     := $(shell command -v xcbeautify >/dev/null 2>&1 && echo "xcbeautify" || echo "cat")
# The simulator build's configuration. `Release` is what Apple's reviewer and
# readers get: it leaves out the debug capture code, so walk the store build as the
# reviewer would with `CONFIG=Release` (the walk-app skill's reviewer walk). The
# probe still answers in it (launch item ㊱). The Mac follows it too.
CONFIG       ?= Debug
IPAD_APP      = $(DERIVED)/Build/Products/$(CONFIG)-iphonesimulator/Hifth.app
# The Mac app in Release is sandboxed, as the Mac store requires (launch item ⑧).
# On this laptop it runs under its own id (MAC_ID), so it keeps its own data
# folder, which can be emptied for a true first open, and never touches the
# everyday Debug app's saved notes. The id the store sees is the real one: the
# suffix is given here, on the command line, and never in the project.
# This copy is signed on the laptop with no profile from Apple, so it gets the
# store's permissions minus Sign in with Apple (Hifth-macOS-Laptop.entitlements).
MAC_RELEASE   = $(filter Release,$(CONFIG))
MAC_ID        = $(BUNDLE_ID)$(if $(MAC_RELEASE),.release)
MAC_ID_ARG    = $(if $(MAC_RELEASE),PRODUCT_BUNDLE_IDENTIFIER=$(MAC_ID) CODE_SIGN_ENTITLEMENTS=Hifth/Resources/Hifth-macOS-Laptop.entitlements)
MAC_APP       = $(DERIVED)/Build/Products/$(CONFIG)/Hifth.app
# A sandboxed app may write only inside its own data folder ("Operation not
# permitted" anywhere else, tried 2026-11-17). So in Release a picture is
# written there and copied out to where it was asked for.
MAC_INSIDE    = $(HOME)/Library/Containers/$(MAC_ID)/Data/tmp
mac_write_at  = $(if $(MAC_RELEASE),$(MAC_INSIDE)/$(notdir $(1)),$(abspath $(1)))
mac_copy_out  = $(if $(MAC_RELEASE),cp $(call mac_write_at,$(1)) $(abspath $(1)))
# The Mac app is started through macOS's launcher, never by running the binary
# inside it: started that way it runs with no window at all, so the page is
# 0×0 and hidden and its picture comes out empty (native-shell.md ⑪). A new
# copy (-n), in the background so it does not take the keyboard from whatever
# you are in (-g), with no windows restored from last time (-F), waiting until
# it quits (-W); what it prints lands in MAC_LOG. Add `--env NAME=value`.
MAC_LOG      := $(DERIVED)/mac-stdout.log
MAC_OPEN     := open -n -g -F -W --stdout $(abspath $(MAC_LOG)) --stderr $(abspath $(MAC_LOG))
# app-shot TARGET=mac WINDOW=1280x800: open the window at that size instead of
# the usual one (the store's Mac screenshots must be 16:10, launch item ㉛).
WINDOW       ?=
MAC_WINDOW_ARG = $(if $(WINDOW),--env HIFTH_WINDOW_SIZE=$(WINDOW))
# app-store-shots: where the store's screenshots go, and what decides them.
STORE_SHOTS  ?= $(SHOTS)/store
STORE_SHOTS_JS := .claude/skills/release-app/scripts/store-shots.mjs
# Which web build goes in: `pitch` (private, with the held commentary) or
# `public` (what the site ships).
FLAVOUR      ?= pitch
# The simulator the iPad targets use. Any name from `xcrun simctl list devices`.
IPAD         ?= iPad Pro 13-inch (M5)
IPAD_UDID     = $(shell $(NATIVE)/scripts/simulator-udid.sh "$(IPAD)")
ROUTE        ?= /hafs-kfqc/2:255
TARGET       ?= ipad
# app-probe: one more JavaScript question for the page, asked DELAY_MS after it
# says it is ready (double quotes inside it; the Makefile wraps it in single).
# A longer one goes in a file, EVALFILE=path, and may hold any quote at all.
EVAL         ?=
EVALFILE     ?=
# The question as the launch line hands it on. Its dollar signs are the page's,
# not make's: read as a make variable, `/^Close$/` reached the page as `/^Close`.
PROBE_EVAL    = $(if $(EVALFILE),"$$(cat '$(EVALFILE)')",'$(value EVAL)')
# app-probe SIDEWAYS=1: where the app keeps its answer for the UI test to read.
PROBE_OUT    ?= $(SHOTS)/probe-side.json
# app-probe PROBE_SHOT=file.png: also keep a picture of the page as the question
# left it (the app quits once it answers, so a screenshot taken after is of the
# home screen). Kept outside the repository when the page may show a note.
PROBE_SHOT   ?=
PROBE_SHOT_AT = $(if $(PROBE_SHOT),$(abspath $(PROBE_SHOT)))
# The same picture as the Mac app writes it (inside its own folder in Release).
MAC_PROBE_SHOT_AT = $(if $(PROBE_SHOT),$(call mac_write_at,$(PROBE_SHOT)))
# app-probe SIDEWAYS=1 TURNS=12,24: seconds after launch at which the UI test
# turns the iPad upright, then back on its side (an even count, so it ends on
# its side), while the question watches. Only a UI test can turn the simulator.
TURNS        ?=
# app-probe SIDEWAYS=1 STEPS=/abs/steps.json: walk a list of steps in one start
# of the app (make pitch-walk writes the list); answers land beside the list.
STEPS        ?=
# app-test: some XCUITests instead of the whole run, space-separated, e.g. ONLY=SmokeTests/testOpensAtAVerse
ONLY         ?=
# app-walk: the routes to open, space-separated, and whether to hold it sideways.
ROUTES       ?= $(ROUTE)
SIDEWAYS     ?=
# Upright and sideways pictures in their own folders, so one run never
# deletes the other's before anyone has looked at them.
WALK_OUT     ?= $(SHOTS)/walk/$(if $(SIDEWAYS),side,upright)
DELAY_MS     ?= 2000
APPEARANCE   ?= light
# The language to launch in (ar, en); empty keeps the app's own choice. It
# sets the device language and also names it for this launch (--lang=), which
# the app shows over a language the reader picked with its own button, without
# changing that pick: the iPad simulator has Arabic picked (2026-10-09).
LOCALE       ?=
LOCALE_ARGS   = $(if $(LOCALE),-AppleLanguages '($(LOCALE))' --lang=$(LOCALE))
MAC_ARGS      = $(if $(LOCALE),--args $(LOCALE_ARGS))
# `/hafs-kfqc/p45?field=dark` → `ipad-hafs-kfqc_p45_field-dark.png`
# Where `app-shot` writes; `app-golden` points it at native/shots/current/.
SHOT_OUT     ?= $(SHOTS)/$(SHOT_NAME)
# The routes the shell goldens cover: a verse, a page, and the dark desk.
GOLDEN_ROUTES ?= /hafs-kfqc/2:255 /hafs-kfqc/p45 /hafs-kfqc/p45?field=dark
# The same app on a phone, one route: the shell was first looked at there on
# 2026-09-29 (native-shell.md ③) and this row is what notices if it changes.
IPHONE        ?= iPhone 17
GOLDEN_IPHONE_ROUTES ?= /hafs-kfqc/2:255
# The Apple Development team, read from the signing certificate's "OU" field
# (the bracketed id in its name is the certificate's own, not the team's).
# Only device builds and archives (the Mac's too) need it; simulator and
# everyday Mac builds do not.
TEAM         ?= $(shell sh native/scripts/signing-team.sh)
# The plugged-in iPad, by the name `xcrun devicectl list devices` prints.
DEVICE       ?=
SHOT_NAME     = $(TARGET)-$(subst /,_,$(subst ?,_,$(subst =,-,$(subst :,-,$(patsubst /%,%,$(ROUTE))))))$(if $(filter-out light,$(APPEARANCE)),-$(APPEARANCE),)$(if $(LOCALE),-$(LOCALE)).png

.PHONY: app-icon app-generate app-web app-build-mac app-build-ipad app-run-mac app-run-mac-stdout app-callback-check \
        app-run-ipad app-shot app-probe app-open app-test app-walk app-test-mac-ui app-unit-test app-logs app-clean \
        app-golden app-golden-update app-device-install app-device-open app-release-ipad app-crash-logs app-devices app-device-register app-archive app-export app-testflight \
        walk-pull walk-gallery walk-list walk-current

app-icon: ## Cut every Mac and iPad icon size from the web app's own icon (apps/web/public/icons)
	python3 $(NATIVE)/scripts/make-appicon.py

app-generate: ## Regenerate native/Hifth.xcodeproj from native/project.yml
	@mkdir -p $(WEB_BUNDLE)
	cd $(NATIVE) && xcodegen generate --quiet

app-web: core ## Build the web app and copy it into the shell (FLAVOUR=pitch|public, pitch by default)
	@# The pitch build keeps assets/private (the held commentary); the public
	@# build is copied without it and then checked, so a public shell can never
	@# carry held copy even on a laptop that has it.
ifeq ($(FLAVOUR),pitch)
	@test -e apps/web/public/assets/private/study-quran/1.json || { \
	  echo ""; echo "  No private pitch data at apps/web/public/assets/private/study-quran/"; \
	  echo "  Build it first (node packages/etl/tools/pitch/extract.mjs) or use FLAVOUR=public"; echo ""; exit 1; }
	VITE_PITCH=1 $(WEB) exec vite build --outDir dist-native --emptyOutDir
else
	@# The store build leaves the recitation out (app-store-launch ⑥).
	VITE_NO_RECITATION=1 $(WEB) exec vite build --outDir dist-native --emptyOutDir
endif
	@$(MAKE) --no-print-directory app-web-copy FLAVOUR=$(FLAVOUR)

.PHONY: app-web-copy
# The copy alone, so a test can drive it without a web build. A folder the copy
# skips is also one it never deletes, so the public copy deletes skipped
# folders too: switching from the pitch build must not keep its private folder.
DIST ?= apps/web/dist-native
app-web-copy:
	@mkdir -p $(WEB_BUNDLE)
ifeq ($(FLAVOUR),pitch)
	rsync -a --delete $(DIST)/ $(WEB_BUNDLE)/
else
	rsync -a --delete --delete-excluded --exclude 'assets/private' $(DIST)/ $(WEB_BUNDLE)/
	@test ! -e $(WEB_BUNDLE)/assets/private || { echo "held data reached the public shell bundle"; exit 1; }
	@# The store build leaves the recitation out: Quran.com's terms allow personal
	@# use only (app-store-launch ⑥). Checked on what was copied, not on the flag.
	@# Source maps are skipped: they hold the original source, comments and all,
	@# and are never run.
	@! grep -rlF --exclude='*.map' 'verses.quran.com' $(WEB_BUNDLE) >/dev/null || { \
	  echo "the public shell bundle still streams the recitation (verses.quran.com):"; \
	  grep -rlF --exclude='*.map' 'verses.quran.com' $(WEB_BUNDLE); exit 1; }
endif
	@echo "$(FLAVOUR)" > $(WEB_BUNDLE)/.hifth-web-flavour
	@# The commit, for a walk capture to say which build it came from; its own
	@# file, because app-golden-public reads the flavour file whole.
	@echo "$$(git rev-parse --short=8 HEAD 2>/dev/null || echo unknown)$$(git diff --quiet HEAD 2>/dev/null || echo +changes)" > $(WEB_BUNDLE)/.hifth-web-commit
	@echo "  ✓ $(FLAVOUR) web build in $(WEB_BUNDLE) ($$(find $(WEB_BUNDLE) -type f | wc -l | tr -d ' ') files)"

app-build-mac: app-generate ## Build the Mac app, ad-hoc signed (CONFIG=Release: sandboxed, under its own id)
	set -o pipefail; $(XCB) -scheme Hifth-macOS -configuration $(CONFIG) -destination 'platform=macOS' $(MAC_ID_ARG) build | $(XCPRETTY)

app-build-ipad: app-generate ## Build the iPad app for the simulator
	set -o pipefail; $(XCB) -scheme Hifth-iOS -configuration $(CONFIG) -sdk iphonesimulator \
	  -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' CODE_SIGNING_ALLOWED=NO build | $(XCPRETTY)

app-run-mac: app-build-mac ## Build and open the Mac app (ROUTE=… to open at a route)
	@# Registering the build with Launch Services makes `open hifth://…` land
	@# on this copy and not on an older one lying in DerivedData.
	/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f $(MAC_APP)
	HIFTH_ROUTE=$(ROUTE) open -a $(MAC_APP)

app-callback-check: app-build-mac ## Send one x-callback-url request through macOS to the app and check a second process gets the answer (opens one browser tab)
	$(NATIVE)/scripts/callback-check.sh $(MAC_APP) $(MAC_ID)

app-run-mac-stdout: app-build-mac ## Run the Mac app until you quit it, then print its console output here (live: make app-logs)
	@: > $(MAC_LOG)
	$(MAC_OPEN) --env HIFTH_ROUTE=$(ROUTE) --env HIFTH_APPEARANCE=$(APPEARANCE) $(MAC_APP) $(MAC_ARGS)
	@cat $(MAC_LOG)

app-run-ipad: app-build-ipad ## Boot the simulator, install and launch at ROUTE
	@test -n "$(IPAD_UDID)" || { echo "no simulator named '$(IPAD)'; see xcrun simctl list devices"; exit 1; }
	xcrun simctl bootstatus $(IPAD_UDID) -b
	open -a Simulator
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	SIMCTL_CHILD_HIFTH_ROUTE=$(ROUTE) SIMCTL_CHILD_HIFTH_APPEARANCE=$(APPEARANCE) xcrun simctl launch $(IPAD_UDID) $(BUNDLE_ID) $(LOCALE_ARGS)

app-shot: ## Screenshot the app at ROUTE on TARGET=ipad|mac (APPEARANCE=light|dark) into native/shots/; WHOLE_SCREEN=1 on a simulator takes the whole screen, clock at 9:41 and battery full
# The app takes this picture of itself as it starts, before a UI test could turn it, so it is
# always upright; SIDEWAYS was once passed here and quietly ignored.
ifneq ($(SIDEWAYS),)
	@echo "  ✗ app-shot is upright only: on its side use app-walk SIDEWAYS=1, or app-probe SIDEWAYS=1 PROBE_SHOT=file.png"; exit 1
endif
	@mkdir -p $(SHOTS) $(dir $(SHOT_OUT))
ifeq ($(TARGET),mac)
	$(MAKE) app-build-mac
	@rm -f $(SHOT_OUT) $(call mac_write_at,$(SHOT_OUT)); : > $(MAC_LOG)
	$(MAC_OPEN) --env HIFTH_ROUTE=$(ROUTE) --env HIFTH_APPEARANCE=$(APPEARANCE) $(MAC_WINDOW_ARG) \
	  --env HIFTH_SNAPSHOT_PATH=$(call mac_write_at,$(SHOT_OUT)) $(MAC_APP) $(MAC_ARGS)
	@cat $(MAC_LOG)
	$(call mac_copy_out,$(SHOT_OUT))
else
	$(MAKE) app-build-ipad
	xcrun simctl bootstatus $(IPAD_UDID) -b
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	@rm -f $(SHOT_OUT)
ifneq ($(WHOLE_SCREEN),)
	@# The store's pictures show the clock and battery (launch item ㊹): Apple's usual
	@# 9:41, full signal and a full battery, put back to the real ones afterwards.
	xcrun simctl status_bar $(IPAD_UDID) override --time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 \
	  --cellularMode active --cellularBars 4 --batteryState discharging --batteryLevel 100
endif
	SIMCTL_CHILD_HIFTH_ROUTE=$(ROUTE) SIMCTL_CHILD_HIFTH_APPEARANCE=$(APPEARANCE) \
	  SIMCTL_CHILD_HIFTH_SNAPSHOT_PATH=$(abspath $(SHOT_OUT)) \
	  $(if $(WHOLE_SCREEN),SIMCTL_CHILD_HIFTH_SNAPSHOT_STAY=1) \
	  xcrun simctl launch $(IPAD_UDID) $(BUNDLE_ID) $(LOCALE_ARGS)
	@for i in $$(seq 1 60); do test -s $(SHOT_OUT) && break; sleep 0.5; done
	@test -s $(SHOT_OUT) || { echo "no screenshot after 30 s"; exit 1; }
ifneq ($(WHOLE_SCREEN),)
	@# The app's own picture is its page only, with a plain strip where the clock sits.
	@# It is kept as the sign the page is ready and settled; the whole simulator screen
	@# is photographed over it while the app stays open.
	xcrun simctl io $(IPAD_UDID) screenshot --type=png $(abspath $(SHOT_OUT))
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	xcrun simctl status_bar $(IPAD_UDID) clear
endif
endif
	@# An empty file, or a picture with no pixels, is a failure, not a shot:
	@# the Mac app once wrote 0 bytes here for weeks and this line said ✓.
	@test -s $(SHOT_OUT) || { echo "  ✗ $(SHOT_OUT) is empty"; exit 1; }
	@sips -g pixelWidth $(SHOT_OUT) | awk '/pixelWidth/ { exit !($$2 > 0) }' || { echo "  ✗ $(SHOT_OUT) has no pixels"; exit 1; }
	@echo "  ✓ $(SHOT_OUT)"

# ---- the store's screenshots (launch item ㉛). The list of screens and devices,
# and Apple's sizes, live in store-shots.mjs; this loops over its plan. Each is
# taken of the public build, then any see-through layer is removed (the store
# refuses one), and the check fails on a size the store does not take. The
# pictures stay on the laptop (native/shots/ is ignored); the upload takes them.
.PHONY: app-store-shots
app-store-shots: app-golden-public ## The store's screenshots of the public build: iPhone, iPad and Mac, English and Arabic, at Apple's sizes, into native/shots/store/
	@rm -rf $(STORE_SHOTS) && mkdir -p $(STORE_SHOTS)
	@node $(STORE_SHOTS_JS) plan | while IFS="$$(printf '\t')" read -r locale target sim window route file; do \
	  out=$(STORE_SHOTS)/$$file; mkdir -p "$$(dirname "$$out")"; \
	  if [ "$$target" = mac ]; then \
	    $(MAKE) --no-print-directory app-shot TARGET=mac LOCALE=$$locale WINDOW=$$window ROUTE="$$route" SHOT_OUT="$$out" < /dev/null || exit 1; \
	  else \
	    $(MAKE) --no-print-directory app-shot TARGET=ipad WHOLE_SCREEN=1 IPAD="$$sim" LOCALE=$$locale ROUTE="$$route" SHOT_OUT="$$out" < /dev/null || exit 1; \
	  fi; \
	  magick mogrify -background white -alpha remove -alpha off "$$out" || exit 1; \
	done
	@node $(STORE_SHOTS_JS) check $(STORE_SHOTS)

app-probe: ## Print what the page sees inside the shell, TARGET=mac|ipad [EVAL='js expression' | EVALFILE=path] [DELAY_MS=…] [SIDEWAYS=1 [TURNS=12,24]] [STEPS=/abs/steps.json, iPad only, either way up] [PROBE_SHOT=file.png] [SIGN_IN_URL=http://127.0.0.1:8788, the sign-in server; not the sideways or steps runs]
ifneq ($(TURNS),)
ifneq ($(TARGET)$(SIDEWAYS),ipad1)
	@echo "  ✗ TURNS needs TARGET=ipad SIDEWAYS=1: only the sideways UI test can turn the iPad"; exit 1
endif
endif
ifeq ($(TARGET)$(SIDEWAYS),ipad1)
	@# The app may not turn itself on an iPad, so a UI test turns the
	@# simulator and starts the probe; the app keeps its answer in a file,
	@# named by its absolute path (the app and the test start in different folders).
	@# A restart first, as for a sideways walk: a stuck simulator stays upright.
	$(MAKE) app-generate
	@rm -rf $(SHOTS)/ipad-probe.xcresult $(PROBE_OUT) $(PROBE_SHOT_AT)
	-xcrun simctl shutdown $(IPAD_UDID)
	xcrun simctl boot $(IPAD_UDID)
	xcrun simctl bootstatus $(IPAD_UDID) -b > /dev/null
	@# A walk of steps starts from a fresh app: marks and settings left by
	@# another walk would show in its pictures and change what it measures.
	$(if $(STEPS),-xcrun simctl uninstall $(IPAD_UDID) $(BUNDLE_ID))
	set -o pipefail; TEST_RUNNER_PROBE_OUT='$(abspath $(PROBE_OUT))' TEST_RUNNER_PROBE_ROUTE='$(ROUTE)' TEST_RUNNER_PROBE_EVAL=$(PROBE_EVAL) \
	  TEST_RUNNER_PROBE_DELAY_MS='$(DELAY_MS)' TEST_RUNNER_PROBE_LOCALE='$(LOCALE)' TEST_RUNNER_PROBE_TIMEOUT_S='$(PROBE_TIMEOUT_S)' \
	  TEST_RUNNER_PROBE_SHOT='$(PROBE_SHOT_AT)' TEST_RUNNER_PROBE_TURNS='$(TURNS)' TEST_RUNNER_PROBE_STEPS='$(STEPS)' \
	  $(XCB) -scheme Hifth-iOS -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' \
	  CODE_SIGNING_ALLOWED=NO -resultBundlePath $(SHOTS)/ipad-probe.xcresult \
	  -only-testing:HifthUITests-iOS/WalkTests/testProbeOnItsSide test | $(XCPRETTY)
	@python3 -m json.tool $(PROBE_OUT)
	$(if $(PROBE_SHOT),@ls -l '$(PROBE_SHOT_AT)')
else ifeq ($(TARGET),ipad)
	$(MAKE) app-build-ipad
	xcrun simctl bootstatus $(IPAD_UDID) -b
ifneq ($(STEPS),)
	@# Upright, a list of steps (make pitch-walk UPRIGHT=1) needs no UI test:
	@# a fresh app walks the list, keeps each answer beside it, and quits.
	-xcrun simctl uninstall $(IPAD_UDID) $(BUNDLE_ID)
	@rm -f '$(abspath $(PROBE_OUT))'
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	SIMCTL_CHILD_HIFTH_PROBE=1 SIMCTL_CHILD_HIFTH_ROUTE='$(ROUTE)' SIMCTL_CHILD_HIFTH_PROBE_STEPS='$(STEPS)' \
	  SIMCTL_CHILD_HIFTH_PROBE_PATH='$(abspath $(PROBE_OUT))' \
	  xcrun simctl launch --console-pty --terminate-running-process $(IPAD_UDID) $(BUNDLE_ID) $(LOCALE_ARGS) > /dev/null
	@python3 -m json.tool $(PROBE_OUT)
else
	xcrun simctl install $(IPAD_UDID) $(IPAD_APP)
	-xcrun simctl terminate $(IPAD_UDID) $(BUNDLE_ID) 2>/dev/null
	SIMCTL_CHILD_HIFTH_PROBE=1 SIMCTL_CHILD_HIFTH_ROUTE='$(ROUTE)' SIMCTL_CHILD_HIFTH_PROBE_EVAL=$(PROBE_EVAL) \
	  SIMCTL_CHILD_HIFTH_PROBE_DELAY_MS=$(DELAY_MS) SIMCTL_CHILD_HIFTH_PROBE_SHOT='$(PROBE_SHOT_AT)' \
	  $(if $(SIGN_IN_URL),SIMCTL_CHILD_HIFTH_SIGN_IN_URL='$(SIGN_IN_URL)') \
	  xcrun simctl launch --console-pty --terminate-running-process $(IPAD_UDID) $(BUNDLE_ID) $(LOCALE_ARGS) \
	  | grep '^probe {' | sed 's/^probe //' | python3 -m json.tool
	$(if $(PROBE_SHOT),@ls -l '$(PROBE_SHOT_AT)')
endif
else
	$(MAKE) app-build-mac
	@: > $(MAC_LOG)
	$(MAC_OPEN) --env HIFTH_PROBE=1 --env HIFTH_ROUTE='$(ROUTE)' --env HIFTH_PROBE_EVAL=$(PROBE_EVAL) \
	  --env HIFTH_PROBE_DELAY_MS=$(DELAY_MS) --env HIFTH_PROBE_SHOT='$(MAC_PROBE_SHOT_AT)' \
	  $(if $(SIGN_IN_URL),--env HIFTH_SIGN_IN_URL='$(SIGN_IN_URL)') $(MAC_APP) $(MAC_ARGS)
	@grep '^probe {' $(MAC_LOG) | sed 's/^probe //' | python3 -m json.tool
	$(if $(PROBE_SHOT),$(call mac_copy_out,$(PROBE_SHOT)))
	$(if $(PROBE_SHOT),@ls -l '$(PROBE_SHOT_AT)')
endif

app-open: ## Turn the running app to ROUTE (TARGET=ipad|mac)
ifeq ($(TARGET),mac)
	open "hifth://$(ROUTE)"
else
	xcrun simctl openurl $(IPAD_UDID) "hifth://$(ROUTE)"
endif

app-unit-test: app-generate ## Route, bundle-path and bridge unit tests (Mac, seconds)
	set -o pipefail; $(XCB) -scheme Hifth-macOS -destination 'platform=macOS' -only-testing:HifthTests test | $(XCPRETTY)

app-test: $(if $(ONLY),app-generate,app-unit-test) ## Unit tests plus the XCUITest smoke on the iPad simulator [ONLY=SmokeTests/testName]
	@rm -rf $(SHOTS)/ipad-smoke.xcresult
	set -o pipefail; $(XCB) -scheme Hifth-iOS -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' \
	  CODE_SIGNING_ALLOWED=NO -resultBundlePath $(SHOTS)/ipad-smoke.xcresult \
	  $(foreach t,$(ONLY),-only-testing:HifthUITests-iOS/$(t)) test | $(XCPRETTY)
	@# A name xcodebuild does not know selects nothing, and "0 tests, 0
	@# failures" is a pass: ONLY=HifthUITests/SmokeTests/… once ran nothing, green.
	$(if $(ONLY),@ran=$$(xcrun xcresulttool get test-results summary --path $(SHOTS)/ipad-smoke.xcresult \
	  | sed -n 's/.*"totalTestCount" : \([0-9]*\).*/\1/p'); \
	  [ "$${ran:-0}" -ge $(words $(ONLY)) ] || { echo "  ✗ ONLY named $(words $(ONLY)) test(s) and $${ran:-0} ran: write them as SmokeTests/testName"; exit 1; })

app-walk: app-generate ## Open each of ROUTES in the iPad app (SIDEWAYS=1 to turn it) and save a picture of each to native/shots/walk/upright or side/
	@rm -rf $(SHOTS)/ipad-walk.xcresult $(WALK_OUT)
	@# The simulator sometimes stops turning (it says sideways and stays
	@# upright); a restart cures it, so a sideways walk starts from one.
	$(if $(SIDEWAYS),-xcrun simctl shutdown $(IPAD_UDID))
	$(if $(SIDEWAYS),xcrun simctl boot $(IPAD_UDID))
	$(if $(SIDEWAYS),xcrun simctl bootstatus $(IPAD_UDID) -b > /dev/null)
	set -o pipefail; TEST_RUNNER_WALK_ROUTES='$(ROUTES)' TEST_RUNNER_WALK_SIDEWAYS='$(SIDEWAYS)' TEST_RUNNER_WALK_LOCALE='$(LOCALE)' \
	  $(XCB) -scheme Hifth-iOS -destination 'platform=iOS Simulator,id=$(IPAD_UDID)' \
	  CODE_SIGNING_ALLOWED=NO -resultBundlePath $(SHOTS)/ipad-walk.xcresult \
	  -only-testing:HifthUITests-iOS/WalkTests test | $(XCPRETTY)
	xcrun xcresulttool export attachments --path $(SHOTS)/ipad-walk.xcresult --output-path $(WALK_OUT) > /dev/null
	@node $(NATIVE)/scripts/name-attachments.mjs $(WALK_OUT)

app-test-mac-ui: app-generate ## The XCUITest smoke on the Mac (needs Accessibility permission for your terminal — see docs/design/native-shell.md)
	@rm -rf $(SHOTS)/mac-smoke.xcresult
	set -o pipefail; $(XCB) -scheme Hifth-macOS -destination 'platform=macOS' -only-testing:HifthUITests-macOS \
	  -resultBundlePath $(SHOTS)/mac-smoke.xcresult test | $(XCPRETTY)

# ---- the real app's look: one screenshot per route, against a committed baseline
# Same recipe as the web goldens: `app-golden` fails on a change, you LOOK at
# native/shots/diff/, and only then `app-golden-update` accepts the new look.
app-golden: app-golden-shots ## Screenshot GOLDEN_ROUTES on the iPad (and GOLDEN_IPHONE_ROUTES on the iPhone) simulator and diff against native/shots/baseline/
	$(NATIVE)/scripts/golden-diff.sh $(SHOTS)/current $(SHOTS)/baseline $(SHOTS)/diff

app-golden-update: app-golden-shots ## Accept the current shell screenshots as the new baseline — look at the diff first
	@mkdir -p $(SHOTS)/baseline
	cp $(SHOTS)/current/*.png $(SHOTS)/baseline/
	@echo "  baseline updated: $$(ls $(SHOTS)/baseline | wc -l | tr -d ' ') screenshots"

.PHONY: app-golden-public app-golden-shots
# The baseline is committed to a public repository, so it is taken of the public
# build: a pitch picture of a verse with its note open carries The Study Quran's
# words in its pixels, where no text check can see them (native-shell.md ⑲).
app-golden-public:
	@test "$$(cat $(WEB_BUNDLE)/.hifth-web-flavour 2>/dev/null)" = public || { \
	  echo ""; echo "  The app's comparison pictures are committed to a public repository, so they"; \
	  echo "  are taken of the public build, never the pitch. Run: make app-web FLAVOUR=public"; echo ""; exit 1; }

# Shots are halved (the simulator draws at 2x) so a baseline is a few hundred KB, not 2 MB.
app-golden-shots: app-golden-public
	@rm -rf $(SHOTS)/current && mkdir -p $(SHOTS)/current
	@for r in $(GOLDEN_ROUTES); do \
	  name=$$(printf '%s' "$$r" | sed 's#^/##; s#[/:?=]#_#g'); \
	  $(MAKE) --no-print-directory app-shot TARGET=ipad ROUTE="$$r" SHOT_OUT=$(SHOTS)/current/ipad-$$name.png || exit 1; \
	  magick mogrify -resize 50% $(SHOTS)/current/ipad-$$name.png; \
	done
	@for r in $(GOLDEN_IPHONE_ROUTES); do \
	  name=$$(printf '%s' "$$r" | sed 's#^/##; s#[/:?=]#_#g'); \
	  $(MAKE) --no-print-directory app-shot TARGET=ipad IPAD="$(IPHONE)" ROUTE="$$r" SHOT_OUT=$(SHOTS)/current/iphone-$$name.png || exit 1; \
	  magick mogrify -resize 50% $(SHOTS)/current/iphone-$$name.png; \
	done

# ---- register a new plugged-in device with Apple, then install as usual. This
# uses one of the account's 100 slots for that kind of device until the
# membership year ends, even if the device is removed later, so ask the owner
# first (the add-device skill). A device already registered uses no new slot.
app-device-register: app-generate ## Register a new plugged-in device with Apple (one of the year's 100 slots for its kind), then install (DEVICE=…)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	@test -n "$(TEAM)" || { echo "  no Apple Development identity in the keychain (TEAM= to override)"; exit 1; }
	@sh native/scripts/xcode-account.sh
	@udid=$$(node native/scripts/device-udid.mjs --device "$(DEVICE)") || exit 1; \
	  set -o pipefail; $(XCB) -scheme Hifth-iOS -destination "id=$$udid" -allowProvisioningUpdates \
	  -allowProvisioningDeviceRegistration DEVELOPMENT_TEAM=$(TEAM) build | $(XCPRETTY)
	@$(MAKE) --no-print-directory app-device-install DEVICE="$(DEVICE)"

app-profile-allows: ## Say whether each signing profile Xcode downloaded allows a permission (KEY=, default Sign in with Apple); prints no team id
	@sh native/scripts/profile-allows.sh --installed $(or $(KEY),com.apple.developer.applesignin)

# ---- a real iPad over USB
app-device-install: app-generate ## Build for a plugged-in iPad, install and launch at ROUTE (DEVICE=<name from `xcrun devicectl list devices`>)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	@test -n "$(TEAM)" || { echo "  no Apple Development identity in the keychain (TEAM= to override)"; exit 1; }
	@sh native/scripts/xcode-account.sh
	set -o pipefail; $(XCB) -scheme Hifth-iOS -destination 'generic/platform=iOS' -allowProvisioningUpdates \
	  DEVELOPMENT_TEAM=$(TEAM) build | $(XCPRETTY)
	@udid=$$(node native/scripts/device-udid.mjs --device "$(DEVICE)") || exit 1; \
	  sh native/scripts/profile-lasts.sh $(DERIVED)/Build/Products/Debug-iphoneos/Hifth.app "$$udid"
	xcrun devicectl device install app --device "$(DEVICE)" $(DERIVED)/Build/Products/Debug-iphoneos/Hifth.app
	$(if $(filter watch,$(LAUNCH)),node native/scripts/release-watch.mjs --device "$(DEVICE)" --route "$(ROUTE)" \
	  --log $(RELEASE_LOG) --out $(CRASH_DIR) --watch $(WATCH),DEVICECTL_CHILD_HIFTH_ROUTE=$(ROUTE) xcrun devicectl device process launch --device "$(DEVICE)" $(BUNDLE_ID))

# Hands one link to the app on a plugged-in iPad, the cards' command on the features page
# (make feature-links). Whether it turns the page of an app already open, or restarts it,
# is the first open question in docs/design/feature-links.md.
app-device-open: ## Send one link to the app on a plugged-in iPad (DEVICE=… LINK='hifth://x-callback-url/open?page=7')
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	@case '$(LINK)' in hifth://*) ;; *) echo "  LINK= must be a hifth:// link, e.g. LINK='hifth://x-callback-url/open?page=7'"; exit 1;; esac
	xcrun devicectl device process launch --device "$(DEVICE)" --payload-url '$(LINK)' $(BUNDLE_ID)

# ---- a card of things to check, on the app's screen (docs/design/check-card.md).
# Builds a `check` link from a ledger row (ID=) or a steps file (FILE=) and sends
# it; Done on the card saves the answers, and check-answers copies them into
# native/shots/checks/ (ignored by git). Builds from this laptop only.
CHECK_CARD = node .claude/skills/guided-check/scripts/check-card.mjs
CHECK_FROM = $(if $(ID),--ledger $(ID))$(if $(FILE),--file $(FILE)) $(if $(FROM),--from $(FROM))
CHECK_TO   = $(if $(SIM),--sim,--device "$(DEVICE)")
check-card: ## Put a card of things to check on the app's screen (ID=<ledger row> or FILE=<steps.json>, FROM=13, SIM=1 or DEVICE=…)
	@test -n "$(ID)$(FILE)" || { echo "  Say what to check: ID=<a row in docs/validation/ledger.json> or FILE=<steps.json>"; exit 1; }
	@test -n "$(SIM)$(DEVICE)" || { echo ""; echo "  Say where: SIM=1 for the booted simulator, or DEVICE= one of:"; xcrun devicectl list devices; echo ""; exit 1; }
	@$(CHECK_CARD) send $(CHECK_FROM) $(CHECK_TO)

check-answers: ## Copy the check card's answers off the app into native/shots/checks (SIM=1 or DEVICE=…; ALSO=Documents/<folder> brings a build's own log too)
	@test -n "$(SIM)$(DEVICE)" || { echo ""; echo "  Say where from: SIM=1 for the booted simulator, or DEVICE= one of:"; xcrun devicectl list devices; echo ""; exit 1; }
	@$(CHECK_CARD) answers $(CHECK_TO) $(if $(ALSO),--also "$(ALSO)")

# ---- release to the plugged-in iPad, with the checks that would have caught the
# touch crash (docs/issues/ipad-crash-on-verse-touch.md): the unit tests, the
# verse-touch test on the iPad's own OS in the simulator, then the install, then
# the app opened with its output saved and watched for WATCH seconds. Fails if
# the app closes by itself, prints an uncaught error, or leaves a new crash report.
RELEASE_IPAD  ?= Hifth iPad 18.5
RELEASE_TESTS ?= SmokeTests/testTouchingAVerseKeepsTheAppOpen
WATCH         ?= 60
RELEASE_LOG   ?= $(DERIVED)/release-console.log
LAUNCH        ?=
app-release-ipad: ## The iPad checks, then install on the plugged-in iPad and open it watched; fails on a new crash report (DEVICE=…, WATCH=60)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	$(MAKE) --no-print-directory app-unit-test
	$(MAKE) --no-print-directory app-test IPAD="$(RELEASE_IPAD)" ONLY="$(RELEASE_TESTS)"
	$(MAKE) --no-print-directory app-device-install DEVICE="$(DEVICE)" LAUNCH=watch
	@echo "  ✓ released to the iPad: checks passed, no crash in $(WATCH)s. Its output: $(RELEASE_LOG)"

# Where the iPad's crash reports land (gitignored: native/build/).
CRASH_DIR    ?= $(DERIVED)/crashes
SINCE        ?=
app-crash-logs: ## Copy the app's crash reports off a plugged-in iPad and say what stopped it (DEVICE=…, SINCE=<ISO time>)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	node .claude/skills/crash-logs/scripts/pull-crashes.mjs --device "$(DEVICE)" --out $(CRASH_DIR) $(if $(SINCE),--since $(SINCE))

# ---- walk captures: what the debug app kept each time the owner took a
# screenshot on the iPad. They land in native/shots/walks/ (gitignored): a pitch
# capture shows the book's text, so it is never committed or sent anywhere.
WALK_CAPTURES = node .claude/skills/walk-app/scripts/walk-captures.mjs
CLEAR        ?=
JSON         ?=
walk-pull: ## Copy the walk captures off a plugged-in iPad and draw them as one page (DEVICE=…, CLEAR=1 empties the iPad after a full copy)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	$(WALK_CAPTURES) pull --device "$(DEVICE)" $(if $(CLEAR),--clear)

walk-gallery: ## Redraw the walk captures page (native/shots/walks/index.html) from what was pulled
	@$(WALK_CAPTURES) gallery

walk-list: ## The walk captures pulled so far, oldest first, one line each (JSON=1 for the list as JSON)
	@$(WALK_CAPTURES) list $(if $(JSON),--json)

walk-current: ## Where the app on a plugged-in iPad is, as current-to-file last wrote it (DEVICE=…)
	@test -n "$(DEVICE)" || { echo ""; echo "  DEVICE= is empty. Pick a name from:"; xcrun devicectl list devices; echo ""; exit 1; }
	@$(WALK_CAPTURES) current --device "$(DEVICE)"

# The capture is for builds from this laptop only. Builds the iPad app both
# ways for a real iPad (unsigned, so no device is needed) and fails if the
# release build has the Files app settings or any of the capture code.
#
# RELEASE_FLAVOUR=public also fails it unless the built release app is the
# public build. Empty by default: this check runs on laptops whose web build is
# the pitch, and the capture question is the same for both.
#
# TARGET=mac checks the Mac app instead: the same two builds the Mac commands
# make (Release sandboxed, under its own id), and the release one's signed
# permissions must be the three the Mac store build asks for (launch item 8).
RELEASE_CHECK_DD := $(DERIVED)/release-check
RELEASE_FLAVOUR ?=
ifeq ($(TARGET),mac)
app-release-check: ## Fail if the release build carries any of the walk capture (builds Debug and Release, a few minutes; TARGET=mac for the Mac app and its permissions; RELEASE_FLAVOUR=public also requires the public build)
	@$(MAKE) --no-print-directory app-build-mac CONFIG=Debug
	@$(MAKE) --no-print-directory app-build-mac CONFIG=Release
	node .claude/skills/walk-app/scripts/release-check.mjs \
	  --debug $(DERIVED)/Build/Products/Debug/Hifth.app \
	  --release $(DERIVED)/Build/Products/Release/Hifth.app \
	  $(if $(RELEASE_FLAVOUR),--flavour $(RELEASE_FLAVOUR))
else
app-release-check: app-generate
	@for config in Debug Release; do \
	  set -o pipefail; xcodebuild -quiet -project $(XCPROJ) -derivedDataPath $(RELEASE_CHECK_DD) -scheme Hifth-iOS \
	    -configuration $$config -destination generic/platform=iOS CODE_SIGNING_ALLOWED=NO build || exit 1; \
	done
	node .claude/skills/walk-app/scripts/release-check.mjs \
	  --debug $(RELEASE_CHECK_DD)/Build/Products/Debug-iphoneos/Hifth.app \
	  --release $(RELEASE_CHECK_DD)/Build/Products/Release-iphoneos/Hifth.app \
	  $(if $(RELEASE_FLAVOUR),--flavour $(RELEASE_FLAVOUR))
endif

# ---- which devices Apple has registered for us, and the slots left (100 of each
# kind a year). CSV=1 prints a row per device with its full id: keep it off the repo.
CSV          ?=
app-devices: ## List the registered devices and how many slots of each kind are left this year (CSV=1 for a spreadsheet)
	@node .claude/skills/add-device/scripts/device-list.mjs $(if $(CSV),--csv)

# ---- The version and build number, from native/project.yml
# Every upload needs a build number Apple has not seen, so setting a version
# raises the build too. A version lower than today's is refused.
VERSION      ?=
NEXT_BUILD   ?=
.PHONY: app-version
app-version: ## Say the app's version and build number; VERSION=1.0.0 sets the version and raises the build, NEXT_BUILD=1 raises the build only
	@node .claude/skills/release-app/scripts/app-version.mjs $(if $(VERSION),--version $(VERSION)) $(if $(NEXT_BUILD),--next-build)

# ---- A build for upload: two locks, and both must open
# 1. Which build it is. The web part is the private pitch by default, and the
#    pitch carries The Study Quran's commentary, so an archive is only ever
#    made of the public build. Checked first, on the web folder, so a pitch
#    build stops in a second; checked again on the built app by the release
#    check below, because that is what would be uploaded. If a private build
#    is ever sent to named testers, it gets a target of its own, not this one.
# 2. The licence. Even the public build carries data whose licence may not
#    allow the App Store, so the upload refuses until docs/decisions.json
#    settles `native-testflight-licence` on an upload option (A or B). Settled
#    on C, own devices only, it still refuses. The archive and the export stay
#    on this laptop, so they do not wait on it (2026-11-16): the store build
#    can be made and checked while the rights holders are asked.
.PHONY: app-store-flavour
app-store-flavour: ## Fail unless the web build in the app is the public one (the only build that may be archived)
	@test "$$(cat $(WEB_BUNDLE)/.hifth-web-flavour 2>/dev/null)" = public || { \
	  echo ""; echo "  A build for upload is made of only the public build, never the pitch, which"; \
	  echo "  carries the held commentary. This one says: $$(cat $(WEB_BUNDLE)/.hifth-web-flavour 2>/dev/null || echo nothing)."; \
	  echo "  Run: make app-web FLAVOUR=public"; echo ""; exit 1; }

TESTFLIGHT_SETTLED = $(shell node scripts/testflight-allowed.mjs 2>/dev/null && echo yes || echo no)
define TESTFLIGHT_GATE
	@test "$(TESTFLIGHT_SETTLED)" = yes || { echo ""; \
	  echo "  Not yet. A build goes to anyone outside only once the licence question is settled:"; \
	  echo "  docs/decisions/native-testflight-licence.md must say A or B; today it does not."; echo ""; exit 1; }
endef

ARCHIVE_PATH   ?= $(DERIVED)/store/Hifth.xcarchive
EXPORT_PATH    ?= $(DERIVED)/store/export
EXPORT_OPTIONS := $(NATIVE)/ExportOptions.plist
ARCHIVE_DD     := $(DERIVED)/store/derived
ARCHIVE_RECEIPT := .claude/skills/release-app/scripts/archive-receipt.mjs

app-release-setup: ## Is this laptop set up to release? Each thing a release needs, ok or missing, with the page to fix it on
	@dotenvx run --quiet -- node .claude/skills/understanding-processes/scripts/check-release-setup.mjs

app-store-listing: ## The words for Apple's store forms (docs/design/store-listing.md): each field's length against Apple's limit, and that it agrees with the app's settings
	@node .claude/skills/understanding-processes/scripts/check-store-listing.mjs

app-store-reviews: ## Store reviews: ARGS=pull (counts only), waiting, "draft <id> --file F", "approve <id>", "post <id>". Kept in .store/reviews/ (git ignores it); nothing is posted without the owner's yes
	@dotenvx run --quiet -- node .claude/skills/store-feedback/scripts/store-reviews.mjs $(ARGS)

app-store-numbers: ## Downloads from Apple's daily reports: ARGS=pull or summary, with --days N (default 30). Kept in .store/numbers/ (git ignores it); prints counts only
	@dotenvx run --quiet -- node .claude/skills/store-numbers/scripts/store-numbers.mjs $(ARGS)

app-store-crashes: ## What Apple's server collected: test builds' crashes, and freezes and slow launches by build. ARGS="list [--since <ISO time>] [--builds N]" (default list). Kept in .store/crashes/; never asks for a tester's comment or email
	@dotenvx run --quiet -- node .claude/skills/crash-logs/scripts/store-crashes.mjs $(or $(ARGS),list)

app-archive: app-store-flavour app-generate ## Archive the iPad and iPhone app for the store: public build only, checked inside the archive; nothing leaves the laptop
	@test -n "$(TEAM)" || { echo "  no Apple Development identity in the keychain (TEAM= to override)"; exit 1; }
	@sh native/scripts/xcode-account.sh
	@# Nothing ships with the walk capture in it, or as anything but the public build.
	$(MAKE) --no-print-directory app-release-check RELEASE_FLAVOUR=public
	rm -rf $(ARCHIVE_PATH) $(ARCHIVE_PATH).receipt.json
	set -o pipefail; xcodebuild -project $(XCPROJ) -derivedDataPath $(ARCHIVE_DD) -scheme Hifth-iOS \
	  -configuration Release -destination generic/platform=iOS -archivePath $(ARCHIVE_PATH) \
	  -allowProvisioningUpdates DEVELOPMENT_TEAM=$(TEAM) HIFTH_STORE_CONDITION=STORE archive | $(XCPRETTY)
	@# The same check again, on the app inside the archive, because that is what would be uploaded,
	@# and with --store: the archive must also have left out the laptop tools' launch settings.
	node .claude/skills/walk-app/scripts/release-check.mjs \
	  --debug $(RELEASE_CHECK_DD)/Build/Products/Debug-iphoneos/Hifth.app \
	  --release $(ARCHIVE_PATH)/Products/Applications/Hifth.app --flavour public --store
	@# The receipt: only now, with every check passed. The export and the upload
	@# take this archive only while the app inside still matches it file for file.
	@node $(ARCHIVE_RECEIPT) --write $(ARCHIVE_PATH) --flavour public
	@echo "  archive: $(ARCHIVE_PATH)"

# The export signs the archive for the App Store. The first time, Xcode asks
# Apple to make the team's App Store signing certificate, which changes the
# Apple account, so it is run only with the owner's go.
app-export: ## Sign the archive for the App Store, ready to upload (the first run makes the team's App Store certificate in the Apple account)
	@test -d $(ARCHIVE_PATH) || { echo "  no archive at $(ARCHIVE_PATH). Run: make app-archive"; exit 1; }
	@node $(ARCHIVE_RECEIPT) --check $(ARCHIVE_PATH)
	rm -rf $(EXPORT_PATH)
	@# Signs with Apple's online store certificate, through Xcode's own sign-in
	@# (Xcode > Settings > Accounts). The store key cannot: it has no right to
	@# that certificate ("Cloud signing permission error", 2026-11-17).
	@# The setup check only sees that an account is listed, not that its sign-in
	@# is still live, so an expired one is caught here and said plainly.
	set -o pipefail; xcodebuild -exportArchive -archivePath $(ARCHIVE_PATH) -exportPath $(EXPORT_PATH) \
	  -exportOptionsPlist $(EXPORT_OPTIONS) -allowProvisioningUpdates 2>&1 | tee $(EXPORT_PATH).log | $(XCPRETTY) \
	  || { grep -q "session has expired" $(EXPORT_PATH).log && echo "  Xcode's sign-in to the Apple account has expired. Sign in again in Xcode > Settings > Accounts, then: make app-export"; exit 1; }
	@# The export signs the app again, for the store, so the app that would be
	@# sent is the one inside the file: open it and check that one, as the
	@# uploaded app (its debugger permission must be off).
	unzip -q -o $(EXPORT_PATH)/Hifth.ipa -d $(EXPORT_PATH)/opened
	node .claude/skills/walk-app/scripts/release-check.mjs \
	  --debug $(RELEASE_CHECK_DD)/Build/Products/Debug-iphoneos/Hifth.app \
	  --release $(EXPORT_PATH)/opened/Payload/Hifth.app --flavour public --exported
	@echo "  export: $(EXPORT_PATH)"

# Apple's own check of the exported app: its signing, icons, permissions and
# privacy file, against the app's record in App Store Connect. It sends the app
# to Apple, but makes no build anyone can install, puts nothing in the review
# queue and uses no build number, so the owner allowed it before the licence
# answer (launch item 42, 2026-11-17). It takes only an export made after the
# archive's receipt, of an archive the receipt still matches. The key's ID and
# issuer come from the encrypted settings; the key file from
# ~/.appstoreconnect/private_keys/, where altool looks by itself.
app-store-check: ## Send the exported app to Apple for its check (no build anyone can install; allowed before the licence answer)
	@test -f $(EXPORT_PATH)/Hifth.ipa || { echo "  no exported app at $(EXPORT_PATH). Run: make app-export"; exit 1; }
	@test $(EXPORT_PATH)/Hifth.ipa -nt $(ARCHIVE_PATH).receipt.json || { echo "  the exported app is older than the archive. Run: make app-export"; exit 1; }
	@node $(ARCHIVE_RECEIPT) --check $(ARCHIVE_PATH)
	dotenvx run --quiet -- sh -c 'xcrun altool --validate-app -f $(EXPORT_PATH)/Hifth.ipa -t ios --apiKey "$$ASC_KEY_ID" --apiIssuer "$$ASC_ISSUER_ID"'
	@echo "  ✓ Apple's check passed: $(EXPORT_PATH)/Hifth.ipa"

app-testflight: app-store-flavour ## Upload the archive to TestFlight with an App Store Connect API key from the environment (locked until the licence decision allows it)
	$(TESTFLIGHT_GATE)
	$(MAKE) --no-print-directory app-archive
	$(MAKE) --no-print-directory app-export
	@# Apple's check first, and the receipt checked again right before the
	@# upload, so nothing swapped in between is sent.
	$(MAKE) --no-print-directory app-store-check
	@node $(ARCHIVE_RECEIPT) --check $(ARCHIVE_PATH)
	@echo "  upload: not built yet"; exit 1

# ---- The Mac App Store build (launch item 8; the owner's yes, 2026-11-17).
# The same steps as the iPad and iPhone one, in their own folder. The project
# signs the everyday Mac app ad hoc, so only these commands sign it with the
# team, and they keep the real app id: the `.release` suffix the laptop's Mac
# Release builds carry never reaches the archive. The export's first run made
# the team's Mac installer certificate (approved by the owner the same day).
MAC_ARCHIVE_PATH ?= $(DERIVED)/store-mac/Hifth.xcarchive
MAC_EXPORT_PATH  ?= $(DERIVED)/store-mac/export
MAC_ARCHIVE_DD   := $(DERIVED)/store-mac/derived
LSREGISTER       := /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
.PHONY: app-archive-mac app-export-mac app-store-check-mac

app-archive-mac: app-store-flavour app-generate ## Archive the Mac app for the store: public build only, sandboxed, checked inside the archive; nothing leaves the laptop
	@test -n "$(TEAM)" || { echo "  no Apple Development identity in the keychain (TEAM= to override)"; exit 1; }
	@sh native/scripts/xcode-account.sh
	$(MAKE) --no-print-directory app-release-check TARGET=mac RELEASE_FLAVOUR=public
	rm -rf $(MAC_ARCHIVE_PATH) $(MAC_ARCHIVE_PATH).receipt.json
	@# Xcode tells macOS about every Mac app it builds, so a hifth:// link could
	@# open this sandboxed copy, with its own empty data, instead of the reader's
	@# app. Both copies are taken off that list again, even when the archive fails.
	set -o pipefail; xcodebuild -project $(XCPROJ) -derivedDataPath $(MAC_ARCHIVE_DD) -scheme Hifth-macOS \
	  -configuration Release -destination generic/platform=macOS -archivePath $(MAC_ARCHIVE_PATH) \
	  -allowProvisioningUpdates DEVELOPMENT_TEAM=$(TEAM) CODE_SIGN_STYLE=Automatic CODE_SIGN_IDENTITY="Apple Development" \
	  HIFTH_STORE_CONDITION=STORE archive | $(XCPRETTY); s=$$?; \
	  $(LSREGISTER) -u $(MAC_ARCHIVE_DD)/Build/Intermediates.noindex/ArchiveIntermediates/Hifth-macOS/InstallationBuildProductsLocation/Applications/Hifth.app 2>/dev/null; \
	  $(LSREGISTER) -u $(MAC_ARCHIVE_PATH)/Products/Applications/Hifth.app 2>/dev/null; exit $$s
	node .claude/skills/walk-app/scripts/release-check.mjs \
	  --debug $(DERIVED)/Build/Products/Debug/Hifth.app \
	  --release $(MAC_ARCHIVE_PATH)/Products/Applications/Hifth.app --flavour public --store
	@node $(ARCHIVE_RECEIPT) --write $(MAC_ARCHIVE_PATH) --flavour public --by "make app-archive-mac"
	@echo "  archive: $(MAC_ARCHIVE_PATH)"

app-export-mac: ## Sign the Mac archive for the App Store as an installer package, and check the app inside it
	@test -d $(MAC_ARCHIVE_PATH) || { echo "  no archive at $(MAC_ARCHIVE_PATH). Run: make app-archive-mac"; exit 1; }
	@node $(ARCHIVE_RECEIPT) --check $(MAC_ARCHIVE_PATH) --by "make app-archive-mac"
	rm -rf $(MAC_EXPORT_PATH)
	set -o pipefail; xcodebuild -exportArchive -archivePath $(MAC_ARCHIVE_PATH) -exportPath $(MAC_EXPORT_PATH) \
	  -exportOptionsPlist $(EXPORT_OPTIONS) -allowProvisioningUpdates 2>&1 | tee $(MAC_EXPORT_PATH).log | $(XCPRETTY) \
	  || { grep -q "session has expired" $(MAC_EXPORT_PATH).log && echo "  Xcode's sign-in to the Apple account has expired. Sign in again in Xcode > Settings > Accounts, then: make app-export-mac"; exit 1; }
	@# The export signs the app again, for the store, so the app that would be
	@# sent is the one inside the package: open it and check that one too.
	pkgutil --expand-full $(MAC_EXPORT_PATH)/Hifth.pkg $(MAC_EXPORT_PATH)/opened
	node .claude/skills/walk-app/scripts/release-check.mjs \
	  --debug $(DERIVED)/Build/Products/Debug/Hifth.app \
	  --release $(MAC_EXPORT_PATH)/opened/*.pkg/Payload/Hifth.app --flavour public --store
	@echo "  export: $(MAC_EXPORT_PATH)/Hifth.pkg"

# Apple's own check of the Mac package. The owner's yes to Apple's check
# covered the iPad and iPhone app; this one waits until the Mac is added to the
# app's record in App Store Connect, and is run only then.
app-store-check-mac: ## Send the Mac package to Apple for its check (no build anyone can install; run once the Mac is added in App Store Connect)
	@test -f $(MAC_EXPORT_PATH)/Hifth.pkg || { echo "  no exported package at $(MAC_EXPORT_PATH). Run: make app-export-mac"; exit 1; }
	@test $(MAC_EXPORT_PATH)/Hifth.pkg -nt $(MAC_ARCHIVE_PATH).receipt.json || { echo "  the exported package is older than the archive. Run: make app-export-mac"; exit 1; }
	@node $(ARCHIVE_RECEIPT) --check $(MAC_ARCHIVE_PATH) --by "make app-archive-mac"
	dotenvx run --quiet -- sh -c 'xcrun altool --validate-app -f $(MAC_EXPORT_PATH)/Hifth.pkg -t macos --apiKey "$$ASC_KEY_ID" --apiIssuer "$$ASC_ISSUER_ID"'
	@echo "  ✓ Apple's check passed: $(MAC_EXPORT_PATH)/Hifth.pkg"

# ---- One command for the whole release (launch item 22). It runs the steps
# above in order and stops at the first that fails; each step keeps its own
# refusals. It ends at the upload while the licence keeps that locked.
KEEP_VERSION ?=
MAC          ?=
MAC_CHECK    ?=
DRY          ?=
.PHONY: app-release
app-release: ## The whole release: VERSION=1.0.1, NEXT_BUILD=1 or KEEP_VERSION=1; MAC=1 adds the Mac, MAC_CHECK=1 Apple's Mac check; DRY=1 lists the steps only
	@node .claude/skills/release-app/scripts/release.mjs run $(if $(VERSION),--version $(VERSION)) \
	  $(if $(NEXT_BUILD),--next-build) $(if $(KEEP_VERSION),--keep-version) $(if $(MAC),--mac) \
	  $(if $(MAC_CHECK),--mac-check) $(if $(DRY),--dry-run)

app-logs: ## Stream the app's console output (Mac or simulator)
	log stream --predicate 'process == "Hifth"' --level debug

app-clean: ## Remove the shell's build output and generated project
	rm -rf $(DERIVED) $(XCPROJ)
