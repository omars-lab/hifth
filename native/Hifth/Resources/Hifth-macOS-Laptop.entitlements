<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The laptop's own Release copy of the Mac app (make app-build-mac CONFIG=Release, id ending
  ".release"). It is the store's permissions file (Hifth-macOS-Store.entitlements) minus Sign in
  with Apple: this copy is signed on the laptop with no profile from Apple, and Xcode refuses to
  build it with that line. Everything else stays the same, so the sandbox tried here is the real
  one; a test keeps the two files in step. The store archive never uses this file.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
