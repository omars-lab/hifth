# Cloudflare Pages reads this file only at the top of the site, so the app's own rules
# (apps/web/public/_headers) are restated here under /read/. The release leaves the app's
# copy out. Hashed build files never change; everything else revalidates so updates land.
# Cloudflare serves a page at its address without .html (privacy.html at /privacy, the app's
# index.html at /read/), so the rules name those addresses.

/
  Cache-Control: no-cache

/privacy
  Cache-Control: no-cache

/ar/
  Cache-Control: no-cache

/ar/privacy
  Cache-Control: no-cache

/read/assets/*
  Cache-Control: public, max-age=31536000, immutable

/read/icons/*
  Cache-Control: public, max-age=31536000, immutable

/read/assets/pages/*
  Cache-Control: public, max-age=86400, must-revalidate

/read/sw.js
  Cache-Control: no-cache

/read/manifest.webmanifest
  Cache-Control: no-cache

/read/
  Cache-Control: no-cache
