# The file that tells Apple which hifth.app links open the app (launch item 9). It has no
# ending, so Cloudflare would not know it is JSON, and Apple reads it only as JSON. The release
# writes it from this laptop's signing team; it is never checked in.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: no-cache

/read/assets/*
  Cache-Control: public, max-age=31536000, immutable

/read/icons/*
  Cache-Control: public, max-age=31536000, immutable

/read/assets/pages/*
  Cache-Control: public, max-age=86400, must-revalidate

/read/sw.js
  Cache-Control: no-cache

/read/manifest.webmanifest
  Cache-Control: no-cache

# The app (hifth-app-csp-for-the-app). Scripts come from this site only, plus the one script
# written into the app's page, which starts fetching the reader's language early. Its words
# change with every build, so the release fills its fingerprint in where {app-inline-scripts}
# stands, and refuses a folder where it did not. The recitation is fetched from
# verses.quran.com and played from memory (blob:); the pointer shapes are pictures written
# into the styles (data:). Nothing else from another site, and no frames. The offline
# worker (sw.js) gets no rule of its own: one there would govern the worker itself.
/read/
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' {app-inline-scripts}; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: https://verses.quran.com; connect-src 'self' https://verses.quran.com; font-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
