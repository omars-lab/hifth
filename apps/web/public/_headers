# Cloudflare Pages headers.
# Hashed build assets are immutable and cached hard. The service worker,
# manifest, and page SVGs must revalidate so updates land promptly.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Page SVGs are content-addressable by page number, not by hash — let the SW
# and browser revalidate rather than pin a stale page.
/assets/pages/*
  Cache-Control: public, max-age=86400, must-revalidate

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
